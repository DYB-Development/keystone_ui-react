  "files": [
    "src"
  ],
  "scripts": {
    "build": "esbuild src/runtime.js --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=app/assets/javascripts/keystone_ui/react.js",
