  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "license": "MIT"
}
